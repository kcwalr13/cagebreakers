{
  "name": "cagebreakers",
  "version": "0.1.0",
  "description": "An offline number puzzle: one KenKen page, filled in over eight rounds",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "assets": "node scripts/assets.mjs",
    "lab": "tsx lab/pages.ts"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "preact": "^11.0.2"
  },
  "devDependencies": {
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@iconify-json/game-icons": "^1.2.4",
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.5",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  },
  "private": true,
  "type": "module"
}
